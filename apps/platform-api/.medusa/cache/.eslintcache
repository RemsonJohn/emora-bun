erity":1,"message":"156","line":24,"column":3,"nodeType":"157","messageId":"158","endLine":24,"endColumn":26,"fix":"159"},{"ruleId":"160","severity":1,"message":"161","line":116,"column":3,"nodeType":"157","messageId":"158","endLine":116,"endColumn":26,"fix":"162"},"@medusajs/use-medusa-error-not-generic-error","Throw `MedusaError` instead of a generic `Error`. Use `new MedusaError(MedusaError.Types.X, \"...\")` so the error maps to the correct HTTP status.","NewExpression","useMedusaError",["163"],["164"],"@medusajs/step-id-kebab-case","Step id `record-platform-audit` should match the enclosing variable name or filename (expected `record-audit`).","Literal","idMismatch",{"range":"165","text":"166"},"@medusajs/workflow-id-matches-export-or-filename","Workflow id `record-merchant-check` should match the exported workflow name or filename (expected `record-check`).",{"range":"167","text":"168"},{"messageId":"169","data":"170","fix":"171","desc":"172"},{"messageId":"169","data":"173","fix":"174","desc":"172"},[853,876],"\"record-audit\"",[4348,4371],"\"record-check\"","replaceWithMedusaError",{"type":"175"},{"range":"176","text":"177"},"Replace with `new MedusaError(MedusaError.Types.UNEXPECTED_STATE, ...)` (pick the appropriate `MedusaError.Types.*`).",{"type":"175"},{"range":"178","text":"179"},"MedusaError.Types.UNEXPECTED_STATE",[0,415],"import { MedusaError } from \"@medusajs/framework/utils\"\nimport { createCipheriv, createDecipheriv, randomBytes } from \"node:crypto\"\n\n/**\n * Encrypts shop secrets at rest with AES-256-GCM. The key is PLATFORM_SECRETS_KEY\n * (64 hex characters) from the platform's environment, never the database.\n */\nfunction key() {\n  const hex = process.env.PLATFORM_SECRETS_KEY ?? \"\"\n  if (!/^[0-9a-f]{64}$/i.test(hex)) throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"PLATFORM_SECRETS_KEY must be 64 hex characters\")",[0,969],"import { MedusaError } from \"@medusajs/framework/utils\"\nimport { createCipheriv, createDecipheriv, randomBytes } from \"node:crypto\"\n\n/**\n * Encrypts shop secrets at rest with AES-256-GCM. The key is PLATFORM_SECRETS_KEY\n * (64 hex characters) from the platform's environment, never the database.\n */\nfunction key() {\n  const hex = process.env.PLATFORM_SECRETS_KEY ?? \"\"\n  if (!/^[0-9a-f]{64}$/i.test(hex)) throw new Error(\"PLATFORM_SECRETS_KEY must be 64 hex characters\")\n  return Buffer.from(hex, \"hex\")\n}\n\nexport function encryptSecret(plain: string) {\n  const iv = randomBytes(12)\n  const cipher = createCipheriv(\"aes-256-gcm\", key(), iv)\n  const data = Buffer.concat([cipher.update(plain, \"utf8\"), cipher.final()])\n  return [\"v1\", iv.toString(\"base64\"), cipher.getAuthTag().toString(\"base64\"), data.toString(\"base64\")].join(\".\")\n}\n\nexport function decryptSecret(stored: string) {\n  const [version, iv, tag, data] = stored.split(\".\")\n  if (version !== \"v1\" || !iv || !tag || !data) throw new MedusaError(MedusaError.Types.UNEXPECTED_STATE, \"Unknown secret format\")"]