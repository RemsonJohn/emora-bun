# Emora platform API (local). Copy to .env and fill in; never commit .env.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/emora_platform
PORT=9100
# The super admin UI origin(s).
ADMIN_CORS=http://localhost:5175
AUTH_CORS=http://localhost:5175
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
COOKIE_SECRET=CHANGE_ME_RANDOM_64_CHARS
# Encrypts Emora staff 2FA secrets (Medusa auth module).
AUTH_MFA_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_CHARS
# 32 bytes as 64 hex characters; encrypts each shop's PLATFORM_SHARED_SECRET at rest.
PLATFORM_SECRETS_KEY=CHANGE_ME_64_HEX_CHARS
# Shop backends the platform may call (comma-separated origins). Anything else is refused.
ALLOWED_SHOP_ORIGINS=http://localhost:9000,http://localhost:9001

DB_NAME=emora_platform