# Settings for ONE shop's backend. Copy to .env.<shop> (for example .env.sagar)
# and fill in. Never commit the copy. Run with: bun run shop <shop> <command>
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5433/emora_<shop>
PORT=9000
# Only this shop's storefront and dashboard origins.
STORE_CORS=http://localhost:3001
ADMIN_CORS=http://localhost:9000,http://localhost:5174
AUTH_CORS=http://localhost:9000,http://localhost:3001,http://localhost:5174
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
COOKIE_SECRET=CHANGE_ME_RANDOM_64_CHARS
# REDIS_URL=redis://localhost:6379/0   (use a different DB number per shop)

# Used once, when the database is first migrated (initial store setup).
EMORA_SHOP_NAME=Shop name
EMORA_WAREHOUSE_CITY=City
EMORA_WAREHOUSE_PROVINCE=Kerala
EMORA_WAREHOUSE_POSTAL_CODE=000000
EMORA_WAREHOUSE_ADDRESS=Address line
# India delivery: flat charge below the free-delivery threshold (rupees).
# Merchants can change both later in Medusa Admin > Locations & Shipping.
EMORA_SHIPPING_FLAT_INR=79
EMORA_SHIPPING_FREE_ABOVE_INR=1499

# Razorpay TEST keys (Dashboard > Account & Settings > API keys, Test mode).
# Leave empty to run without Razorpay. Never put live keys in a local file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
